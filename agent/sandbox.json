{
  "enabled": true,
  "enableWeakerNetworkIsolation": true,
  "network": {
    "allowLocalBinding": true,
    "allowAllUnixSockets": true,
    "allowedDomains": [
      "localhost",
      "github.com",
      "*.github.com",
      "*.githubcopilot.com",
      "raw.githubusercontent.com",
      "release-assets.githubusercontent.com",
      "results-receiver.actions.githubusercontent.com",
      "*.blob.core.windows.net",
      "buildkite.com",
      "api.buildkite.com",
      "buildkiteartifacts.com",
      "*.npmjs.org",
      "*.pypi.org",
      "*.crates.io",
      "html.duckduckgo.com",
      "mcp.context7.com",
      "proxy.golang.org",
      "nixos.org",
      "search.devbox.sh",
      "storage.googleapis.com",
      "sum.golang.org",
      "*.nixos.org",
      "mcp.atlassian.com",
      "cultureamp.atlassian.net",
      "*.amazonaws.com",
      "*.awsapps.com",
      "*.anthropic.com",
      "mcp.slack.com",
      "mcp.exa.ai",
      "*.schemastore.org",
      "culture-amp-be.glean.com",
      "cf.mcp.atlassian.com",
      "mcp-9827.slack.com",
      "slack.com",
      "mcp.miro.com",
      "http-intake.logs.datadoghq.com",
      "api.flakehub.com",
      "flake-archives.flakehub.com",
      "install.determinate.systems",
      "registry.yarnpkg.com",
      "releases.jetify.com",
      "releases.jetpack.io"
    ],
    "deniedDomains": []
  },
  "filesystem": {
    "denyRead": [
      "~",
      "~/Library/Keychains"
    ],
    "allowRead": [
      ".",
      "/nix",
      "/private/tmp",
      "/private/var/folders",
      "/tmp",
      "~/.agentsview",
      "~/.aws/config",
      "~/.cache",
      "~/.claude",
      "~/.claude.json",
      "~/.config",
      "~/.duckdb",
      "~/.gem_cache",
      "~/.gradle",
      "~/.local",
      "~/.mcporter",
      "~/.nix-defexpr",
      "~/.nix-profile",
      "~/.npm",
      "~/.npm-global",
      "~/.npmrc",
      "~/.pi",
      "~/.yarnrc",
      "~/.yarnrc.yml",
      "~/Downloads/",
      "~/Library/Caches",
      "~/Library/pnpm",
      "~/Library/Application Support/go",
      "~/code",
      "~/go",
      "~/hotel",
      "~/nixfiles",
      "~/obsidian",
      "~/tmp"
    ],
    "allowWrite": [
      ".",
      "/private/tmp",
      "/private/var/folders",
      "/tmp",
      "~/.agentsview",
      "~/.duckdb",
      "~/.cache/gh",
      "~/.cache/nix",
      "~/.cache/node",
      "~/.cache/nvim",
      "~/.cache/pre-commit",
      "~/.cache/prek",
      "~/.cache/uv",
      "~/.gradle",
      "~/.local/share/devbox",
      "~/.local/share/hotel",
      "~/.local/share/nvim",
      "~/.local/state/nvim",
      "~/.mcporter",
      "~/.npm",
      "~/.pi",
      "~/Library/Caches",
      "~/Library/pnpm",
      "~/go",
      "~/hotel",
      "~/tmp"
    ],
    "denyWrite": [
      "/bin",
      "/sbin",
      "/usr/bin",
      "/usr/sbin",
      "*.key",
      "*.pem",
      ".env",
      ".env.*",
      "./.pi/sandbox.json",
      "~/.pi/agent/sandbox.json"
    ]
  }
}
